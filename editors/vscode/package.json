{
  "name": "orviscript",
  "displayName": "OrviScript",
  "description": "Language support for OrviScript",
  "version": "0.3.0",
  "publisher": "orviscript",
  "license": "Apache-2.0",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:orviscript"
  ],
  "scripts": {
    "check": "cargo build --manifest-path ../../Cargo.toml --bin orvi-lsp && node --check extension.js && node --check protocol.mjs && node validate.mjs && node --test --test-concurrency=1 test/*.test.mjs"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "title": "OrviScript",
      "properties": {
        "orviscript.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the orvi-lsp executable. Leave empty to use the workspace build or PATH."
        }
      }
    },
    "languages": [
      {
        "id": "orviscript",
        "aliases": ["OrviScript", "orviscript"],
        "extensions": [".orvi"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/orviscript-file-light.svg",
          "dark": "./icons/orviscript-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "orviscript",
        "scopeName": "source.orviscript",
        "path": "./syntaxes/orviscript.tmLanguage.json"
      }
    ]
  }
}
