{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OrviScript",
  "scopeName": "source.orviscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#functionDeclarations" },
    { "include": "#functionCalls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.orviscript", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.orviscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.orviscript", "match": "\\\\[0nrt\\\\\"]" },
            { "name": "invalid.illegal.escape.orviscript", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.orviscript", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.orviscript", "match": "\\b[0-9]+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.declaration.orviscript", "match": "\\b(?:let|const|fn|struct|interface)\\b" },
        { "name": "keyword.control.orviscript", "match": "\\b(?:if|else|while|return|match|using|defer)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.orviscript", "match": "\\b(?:true|false|null|None)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.builtin.orviscript", "match": "\\b(?:Option|Result|any|bool|float|fn|int|list|map|null|number|string)\\b" }
      ]
    },
    "functionDeclarations": {
      "patterns": [
        { "name": "entity.name.function.orviscript", "match": "(?<=\\bfn\\s)[\\p{L}_][\\p{L}\\p{N}_]*" },
        { "name": "entity.name.type.struct.orviscript", "match": "(?<=\\bstruct\\s)[\\p{L}_][\\p{L}\\p{N}_]*" },
        { "name": "entity.name.type.interface.orviscript", "match": "(?<=\\binterface\\s)[\\p{L}_][\\p{L}\\p{N}_]*" }
      ]
    },
    "functionCalls": {
      "patterns": [
        { "name": "support.function.orviscript", "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()" },
        { "name": "support.function.builtin.orviscript", "match": "\\b(?:Some|Ok|Err)(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.orviscript", "match": "(?:->|=>|==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|=|!|<|>|\\?)" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.orviscript", "match": "[,;:]" },
        { "name": "punctuation.section.group.orviscript", "match": "[(){}\\[\\]]" }
      ]
    }
  }
}
