{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OrviScript",
  "scopeName": "source.orviscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#functionDeclarations" },
    { "include": "#functionCalls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.orviscript", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.orviscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.orviscript", "match": "\\\\[0nrt\\\\\"]" },
            { "name": "invalid.illegal.escape.orviscript", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.orviscript", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.orviscript", "match": "\\b[0-9]+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.declaration.orviscript", "match": "\\b(?:let|const|fn)\\b" },
        { "name": "keyword.control.orviscript", "match": "\\b(?:if|else|while|return)\\b" },
        { "name": "keyword.other.orviscript", "match": "\\b(?:struct|match|async|await|parallel|task|using|defer)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.orviscript", "match": "\\b(?:true|false|null)\\b" }
      ]
    },
    "functionDeclarations": {
      "patterns": [
        { "name": "entity.name.function.orviscript", "match": "(?<=\\bfn\\s)[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    "functionCalls": {
      "patterns": [
        { "name": "support.function.orviscript", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.orviscript", "match": "(?:==|!=|<=|>=|&&|\\|\\||->|=>|\\+|-|\\*|/|%|=|!|<|>)" }
      ]
    }
  }
}
