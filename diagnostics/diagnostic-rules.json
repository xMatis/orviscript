{
  "$schema": "./diagnostic-rules.schema.json",
  "schemaVersion": 1,
  "includes": [],
  "rules": [
    {
      "id": "ORVI1001",
      "category": "foreign_syntax",
      "match": { "token": "function", "context": "function_declaration" },
      "message": "Unknown function declaration. Did you mean 'fn'?",
      "replacement": "fn",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["javascript", "typescript"]
    },
    {
      "id": "ORVI1002",
      "category": "foreign_syntax",
      "match": { "token": "def", "context": "function_declaration" },
      "message": "Python-style function declaration. Use 'fn' instead.",
      "replacement": "fn",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["python"]
    },
    {
      "id": "ORVI1003",
      "category": "foreign_syntax",
      "match": { "token": "func", "context": "function_declaration" },
      "message": "Use 'fn' for a function declaration.",
      "replacement": "fn",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["go", "swift"]
    },
    {
      "id": "ORVI1004",
      "category": "foreign_syntax",
      "match": { "token": "fun", "context": "function_declaration" },
      "message": "Use 'fn' for a function declaration.",
      "replacement": "fn",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["kotlin"]
    },
    {
      "id": "ORVI1005",
      "category": "foreign_syntax",
      "match": { "token": "var", "context": "variable_declaration" },
      "message": "Use 'let' for a mutable variable.",
      "replacement": "let",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["javascript", "typescript", "go"]
    },
    {
      "id": "ORVI1006",
      "category": "foreign_syntax",
      "match": { "token": "val", "context": "variable_declaration" },
      "message": "Use 'const' for a binding that cannot be reassigned.",
      "replacement": "const",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["kotlin", "scala"]
    },
    {
      "id": "ORVI1011",
      "category": "foreign_syntax",
      "match": { "token": "True", "context": "expression" },
      "message": "Boolean literals are lowercase in OrviScript. Use 'true'.",
      "replacement": "true",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["python"]
    },
    {
      "id": "ORVI1012",
      "category": "foreign_syntax",
      "match": { "token": "False", "context": "expression" },
      "message": "Boolean literals are lowercase in OrviScript. Use 'false'.",
      "replacement": "false",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["python"]
    },
    {
      "id": "ORVI1015",
      "category": "foreign_syntax",
      "match": { "token": "println", "context": "expression" },
      "message": "Use the built-in 'print' function.",
      "replacement": "print",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["rust", "kotlin"]
    },
    {
      "id": "ORVI1018",
      "category": "foreign_syntax",
      "match": { "token": "require", "context": "import" },
      "message": "CommonJS require is not supported. Use an OrviScript import declaration.",
      "replacement": "import",
      "severity": "error",
      "quickFix": false,
      "priority": 100,
      "sourceLanguages": ["javascript"]
    },
    {
      "id": "ORVI1021",
      "category": "foreign_syntax",
      "match": { "token": "str", "context": "type_position" },
      "message": "Use 'string' instead of Python 'str'.",
      "replacement": "string",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["python"]
    },
    {
      "id": "ORVI1022",
      "category": "foreign_syntax",
      "match": { "token": "String", "context": "type_position" },
      "message": "Use the lowercase 'string' type.",
      "replacement": "string",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["java", "kotlin", "rust"]
    },
    {
      "id": "ORVI1023",
      "category": "foreign_syntax",
      "match": { "token": "boolean", "context": "type_position" },
      "message": "Use 'bool' instead of 'boolean'.",
      "replacement": "bool",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["typescript", "java"]
    },
    {
      "id": "ORVI1024",
      "category": "foreign_syntax",
      "match": { "token": "Boolean", "context": "type_position" },
      "message": "Use the lowercase 'bool' type.",
      "replacement": "bool",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["java", "kotlin"]
    },
    {
      "id": "ORVI1026",
      "category": "foreign_syntax",
      "match": { "token": "List", "context": "type_position" },
      "message": "Use lowercase 'list<T>'.",
      "replacement": "list",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["python", "java", "kotlin"]
    },
    {
      "id": "ORVI1027",
      "category": "foreign_syntax",
      "match": { "token": "Array", "context": "type_position" },
      "message": "Use 'list<T>' instead of 'Array<T>'.",
      "replacement": "list",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["typescript"]
    },
    {
      "id": "ORVI1028",
      "category": "foreign_syntax",
      "match": { "token": "dict", "context": "type_position" },
      "message": "Use 'map<T>' instead of Python 'dict'.",
      "replacement": "map",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["python"]
    },
    {
      "id": "ORVI1031",
      "category": "foreign_syntax",
      "match": { "token": "nil", "context": "expression" },
      "message": "Use 'None' for an empty Option value.",
      "replacement": "None",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["lua", "go", "swift"]
    },
    {
      "id": "ORVI1032",
      "category": "foreign_syntax",
      "match": { "token": "undefined", "context": "expression" },
      "message": "OrviScript does not use 'undefined'. Model absence with Option<T>.",
      "replacement": "None",
      "severity": "error",
      "quickFix": false,
      "priority": 100,
      "sourceLanguages": ["javascript", "typescript"]
    },
    {
      "id": "ORVI1041",
      "category": "foreign_syntax",
      "match": { "token": "and", "context": "expression" },
      "message": "Use '&&' for logical AND.",
      "replacement": "&&",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["python"]
    },
    {
      "id": "ORVI1042",
      "category": "foreign_syntax",
      "match": { "token": "or", "context": "expression" },
      "message": "Use '||' for logical OR.",
      "replacement": "||",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["python"]
    },
    {
      "id": "ORVI1043",
      "category": "foreign_syntax",
      "match": { "token": "not", "context": "expression" },
      "message": "Use '!' for logical negation.",
      "replacement": "!",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["python"]
    },
    {
      "id": "ORVI1044",
      "category": "foreign_syntax",
      "match": { "token": "Vec", "context": "type_position" },
      "message": "Use 'list<T>' instead of Rust 'Vec<T>'.",
      "replacement": "list",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["rust"]
    },
    {
      "id": "ORVI1045",
      "category": "foreign_syntax",
      "match": { "token": "HashMap", "context": "type_position" },
      "message": "Use 'map<T>' instead of Rust 'HashMap'.",
      "replacement": "map",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["rust"]
    },
    {
      "id": "ORVI1046",
      "category": "foreign_syntax",
      "match": { "token": "Dictionary", "context": "type_position" },
      "message": "Use 'map<T>' instead of 'Dictionary'.",
      "replacement": "map",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["csharp", "swift"]
    },
    {
      "id": "ORVI1047",
      "category": "foreign_syntax",
      "match": { "token": "double", "context": "type_position" },
      "message": "Use the OrviScript 'float' type.",
      "replacement": "float",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["java", "c", "cpp", "csharp"]
    },
    {
      "id": "ORVI1048",
      "category": "foreign_syntax",
      "match": { "token": "long", "context": "type_position" },
      "message": "Use the OrviScript 'int' type.",
      "replacement": "int",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["java", "c", "cpp", "csharp"]
    },
    {
      "id": "ORVI1049",
      "category": "foreign_syntax",
      "match": { "token": "char", "context": "type_position" },
      "message": "OrviScript strings represent text. Use 'string'.",
      "replacement": "string",
      "severity": "error",
      "quickFix": true,
      "priority": 100,
      "sourceLanguages": ["java", "c", "cpp", "csharp", "rust"]
    }
  ]
}
